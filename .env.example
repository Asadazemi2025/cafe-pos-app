# ----- チーム共通の合言葉(入口の鍵) -----
TEAM_PASSPHRASE="カフェの合言葉をここに"
# 合言葉が正しいときにブラウザへ渡す内部トークン(推測されない長い文字列にする)
# 例: ターミナルで `openssl rand -hex 32` を実行して出た値を貼る
TEAM_SESSION_TOKEN="ここに長いランダム文字列"

# ----- Supabase -----
# Supabase ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# サーバー専用キー(絶対に外部に出さない / ブラウザには渡らない)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ----- Database (Prisma) -----
# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL="postgresql://postgres:[password]@db.xxxxx.supabase.co:5432/postgres"

# ----- Stripe (カード決済) -----
# Stripeダッシュボード > 開発者 > APIキー(最初はテストモードのキーを使う)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
