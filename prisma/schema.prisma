generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- イベント日 ----------

// 出店するイベント1日分。売上・レジ締め・経費はこの単位で分ける。
// 材料・メニュー・在庫は全イベント共通(前回の余りを次回も使うため)。
model Event {
  id        String          @id @default(cuid())
  name      String
  // 開始日(README の Event.start)
  date      DateTime        @db.Date
  // 営業日数(1〜14)。1日目=dayIndex 0
  days      Int             @default(1)
  createdAt DateTime        @default(now())
  sales     Sale[]
  expenses  Expense[]
  sessions  DailyRegister[]
  journal   JournalEntry[]
  plan      ProfitPlan?
  actions   ActionPlan[]
  surveys   SurveyResponse[]
  ingredientStocks EventIngredientStock[]
  menuStocks       EventMenuStock[]

  @@index([date])
}

// ---------- 材料・仕入れ ----------

model Ingredient {
  id                String                      @id @default(cuid())
  name              String
  unit              String                      @default("g")
  // g/ml単位の端数を扱うためInt不可
  stock             Decimal                     @default(0) @db.Decimal(14, 3)
  // 直近の仕入単価(移動平均ではなく、シンプルに最新仕入れで上書きする)。
  // purchasePrice / purchaseQty から計算した値が入る。
  costPerUnit       Decimal                     @default(0) @db.Decimal(14, 4)
  // 「300円で100g買った」の300と100。単価を直接入れなくても済むように、
  // 買ったときの値段と量をそのまま持っておく。
  purchasePrice     Decimal?                    @db.Decimal(14, 2)
  purchaseQty       Decimal?                    @db.Decimal(14, 3)
  // 歩留まり(0〜1)。買った量のうち、実際に商品に使える割合。
  // 皮や芯を捨てる野菜、抽出で残るコーヒー粉など、買った量をそのまま
  // 使えない材料のために持つ。原価と在庫の減り方の両方に効く。
  yieldRate         Decimal                     @default(1) @db.Decimal(5, 4)
  lowStockThreshold Decimal?                    @db.Decimal(14, 3)
  isTest            Boolean                     @default(false)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  purchases         IngredientPurchase[]
  adjustments       IngredientStockAdjustment[]
  recipeUses        RecipeIngredient[]
  eventStocks       EventIngredientStock[]
}

// イベントごとの材料在庫。材料そのもの(名前・単位・単価)はイベントをまたいで
// 共通だが、「いま何グラム残っているか」はイベントごとに分ける。
// 前のイベントで使い切った材料が、次のイベントで在庫ありに見えないようにするため。
model EventIngredientStock {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  stock        Decimal    @default(0) @db.Decimal(14, 3)
  updatedAt    DateTime   @updatedAt

  @@unique([eventId, ingredientId])
  @@index([eventId])
}

model IngredientPurchase {
  id             String      @id @default(cuid())
  ingredientId   String?
  ingredient     Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  // 材料が後で削除・改名されても仕入れ履歴の表示が壊れないようスナップショットを保持する
  ingredientName String
  quantity       Decimal     @db.Decimal(14, 3)
  unitCost       Decimal     @db.Decimal(14, 4)
  amount         Decimal     @db.Decimal(14, 2)
  memo           String?
  isTest         Boolean     @default(false)
  createdAt      DateTime    @default(now())
}

enum StockAdjustmentReason {
  MISTAKE
  PURCHASE_DECREASE
  OTHER
}

model IngredientStockAdjustment {
  id             String                @id @default(cuid())
  ingredientId   String?
  ingredient     Ingredient?           @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  ingredientName String
  delta          Decimal               @db.Decimal(14, 3)
  reason         StockAdjustmentReason
  note           String?
  isTest         Boolean               @default(false)
  createdAt      DateTime              @default(now())
}

// ---------- メニュー・レシピ(原価計算) ----------

// 作り方の違い。売れたときに材料を減らすのか、仕込み済みの個数を減らすのか
enum MenuStockMode {
  // 注文を受けてから作る。販売時にレシピ通り材料を消費する
  MADE_TO_ORDER
  // あらかじめ作っておく。仕込み時に材料を消費し、販売時は残り個数だけ減る
  PREPARED
}

model MenuItem {
  id             String             @id @default(cuid())
  name           String
  category       String?
  salePrice      Decimal            @db.Decimal(14, 2)
  showInRegister Boolean            @default(true)
  stockMode      MenuStockMode      @default(MADE_TO_ORDER)
  // PREPAREDのときの「あと何個売れるか」
  preparedStock  Int                @default(0)
  // 基準在庫数(README の par)。在庫バーと「要追加」判定に使う
  par            Int                @default(0)
  // 1個を作って渡すまでにかかる時間(分)。人手がボトルネックのときの
  // 「制約1単位あたり利益(提供時間あたり粗利)」を出すために使う
  prepMinutes    Decimal            @default(0) @db.Decimal(6, 2)
  isTest         Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  recipe         RecipeIngredient[]
  saleItems      SaleItem[]
  preparations   MenuPreparation[]
  eventStocks    EventMenuStock[]
}

// イベントごとの「仕込み済みの残り個数」。メニュー(名前・売価・レシピ)は
// イベントをまたいで共通で、残数だけをイベントごとに分ける。
model EventMenuStock {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  preparedStock Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([eventId, menuItemId])
  @@index([eventId])
}

// 仕込みの記録(何を何個作ったか)。材料はこのタイミングで消費される。
model MenuPreparation {
  id         String   @id @default(cuid())
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuItemName String
  quantity   Int
  isTest     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// レシピ = メニューと材料の中間テーブル。原価はここから都度計算する(保存しない)
model RecipeIngredient {
  id              String     @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantityPerUnit Decimal    @db.Decimal(14, 3)

  @@unique([menuItemId, ingredientId])
}

// ---------- レジ・会計 ----------

enum PaymentMethod {
  CASH
  // Stripe等のカード決済。表示は「キャッシュレス」
  CARD
  // カード以外のキャッシュレス(QR決済など)
  CASHLESS
  // PayPay(店舗のQRコードで受け取ったぶんの記録、およびStripe経由のPayPay決済)
  PAYPAY
  // iD・QUICPay・交通系ICなどの電子マネー(別の決済端末で処理したぶんの記録)
  EMONEY
  // 使用しない。過去の売上が参照している可能性があるため定義だけ残す
  POINT
}

model Sale {
  id                    String        @id @default(cuid())
  eventId               String?
  event                 Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // イベント内の何日目か(0始まり)
  dayIndex              Int           @default(0)
  totalAmount           Decimal       @db.Decimal(14, 2)
  totalCost             Decimal       @db.Decimal(14, 2)
  itemCount             Int
  paymentMethod         PaymentMethod
  stripePaymentIntentId String?       @unique
  voided                Boolean       @default(false)
  isTest                Boolean       @default(false)
  // オフライン再送時の重複防止キー
  clientId              String?       @unique
  occurredAt            DateTime      @default(now())
  createdAt             DateTime      @default(now())
  items                 SaleItem[]

  @@index([eventId])
}

model SaleItem {
  id         String    @id @default(cuid())
  saleId     String
  sale       Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  // メニューが後で改名・レシピ変更されても、この取引時点の内容が変わらないようスナップショットを保持する
  name       String
  unitPrice  Decimal   @db.Decimal(14, 2)
  unitCost   Decimal   @db.Decimal(14, 2)
  quantity   Int
  amount     Decimal   @db.Decimal(14, 2)
  // 会計時点で実際に消費した材料のスナップショット: [{ingredientId, ingredientName, qty}]
  // レシピが後で変わっても、取消(void)時に正しい量を在庫へ戻すために必要
  ingredientUsage Json
  // 仕込み済みの在庫から売れた行かどうか。取消時に材料ではなく個数を戻すために使う
  fromPreparedStock Boolean @default(false)
}

// 営業日ごとのレジ開け/締め(README の Session)
model DailyRegister {
  id           String    @id @default(cuid())
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // イベント内の何日目か(0始まり)
  dayIndex     Int       @default(0)
  // 表示用の日付ラベル(YYYY-MM-DD)
  day          String
  openingCash  Decimal?  @db.Decimal(14, 2)
  openedAt     DateTime?
  closingCash  Decimal?  @db.Decimal(14, 2)
  // 現金過不足の期待値。現金(CASH)の会計のみを対象に計算する
  expectedCash Decimal?  @db.Decimal(14, 2)
  closedAt     DateTime?
  cashCounts   Json?
  // 締めのときに数えた金種の内訳
  closeCounts  Json?

  @@unique([eventId, dayIndex])
}

// 経費の計上単位。1日あたりはそのまま、イベント全体は営業日数で按分する
enum ExpenseScope {
  PER_DAY
  WHOLE_EVENT
}

model Expense {
  id        String       @id @default(cuid())
  eventId   String?
  event     Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name      String
  scope     ExpenseScope @default(PER_DAY)
  amount    Decimal      @db.Decimal(14, 2)
  memo      String?
  photoPath String?
  isTest    Boolean  @default(false)
  spentOn   DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([eventId])
}

// 振り返り画面の営業日誌。営業日ごとに何本でも書ける
model JournalEntry {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  dayIndex  Int      @default(0)
  body      String
  author    String   @default("スタッフ")
  createdAt DateTime @default(now())

  @@index([eventId, dayIndex])
}

// ---------- 管理会計(利益計画・KPI・アンケート) ----------

// イベントごとの利益計画。固定費の回収に加えて、1日いくら残したいか。
model ProfitPlan {
  id                String   @id @default(cuid())
  eventId           String   @unique
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // 固定費を回収したうえで、1日あたりに残したい利益
  dailyProfitTarget Decimal  @default(0) @db.Decimal(14, 2)
  // 1日の営業時間(時間)と、同時に接客できる人数。制約1単位あたり利益の計算に使う
  serviceHours      Decimal  @default(6) @db.Decimal(5, 2)
  staffCount        Int      @default(2)
  memo              String?
  updatedAt         DateTime @updatedAt
}

// KPIの実績をどこから取るか。MANUALは手入力、それ以外は売上・アンケートから自動集計する
enum KpiSource {
  MANUAL
  SALES
  MARGIN
  CUSTOMERS
  UNIT_PRICE
  UNITS
  ATTACH_RATE
  SURVEY_SCORE
}

// アクションプラン → 管理項目(KPI) → 利益目標 のつながりを持たせる
model ActionPlan {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // 打ち手(例: 「ドリンク注文時にフードを一声かける」)
  title       String
  // その打ち手を測る管理項目(例: 「フード併売率」)
  kpiName     String
  kpiUnit     String    @default("")
  targetValue Decimal   @db.Decimal(14, 2)
  source      KpiSource @default(MANUAL)
  // 手入力のKPIの実績値
  manualValue Decimal?  @db.Decimal(14, 2)
  // この打ち手が効いたときに見込む1日あたりの利益増(利益目標とのつながり)
  profitImpact Decimal  @default(0) @db.Decimal(14, 2)
  memo        String?
  createdAt   DateTime  @default(now())

  @@index([eventId])
}

// お客さまアンケート。QRコードから回答してもらう
model SurveyResponse {
  id           String   @id @default(cuid())
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  dayIndex     Int      @default(0)
  // 満足度・再来店意向(ともに1〜5)
  satisfaction Int
  repeatIntent Int?
  ageGroup     String?
  knownFrom    String?
  favoriteItem String?
  comment      String?
  createdAt    DateTime @default(now())

  @@index([eventId, dayIndex])
}

model AppSetting {
  id        String   @id @default("singleton")
  testMode  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
